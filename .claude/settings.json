{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun run build)",
      "Bash(bun run lint)",
      "Bash(bun run start)",
      "Bash(./node_modules/.bin/eslint *)",
      "Bash(./node_modules/.bin/tsc *)",
      "Bash(./node_modules/.bin/prettier *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh-axi *)",
      "Bash(chrome-devtools-axi *)",
      "Bash(lavish-axi *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.envrc)",
      "Edit(./bun.lock)",
      "Edit(./next-env.d.ts)",
      "Edit(./tsconfig.tsbuildinfo)",
      "Edit(./.next/**)",
      "Edit(./node_modules/**)",
      "Edit(./.agents/skills/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/inject-delegation.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-protected-files.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-package-manager.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-changed-file.sh\"",
            "timeout": 60,
            "statusMessage": "Formatting with ESLint"
          }
        ]
      }
    ]
  }
}
